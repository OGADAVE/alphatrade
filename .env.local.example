# ── Client-side Firebase config (safe to expose, NEXT_PUBLIC_ prefix) ──
# Firebase Console → Project Settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Server-only Firebase Admin config (NEVER expose to the browser) ──
# Firebase Console → Project Settings → Service accounts → Generate new
# private key. Paste the private_key value exactly as downloaded, quoted,
# with \n escapes intact.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# ── Webhook secrets ──
# Used as ?secret=... in your TradingView alert's webhook URL.
TRADINGVIEW_WEBHOOK_SECRET=

# ── Market data (Phase 4 — TP/SL tracking) ──
# Crypto prices come from Binance's public API and need no key.
# Forex is split across two providers so neither one's free-tier rate
# limit has to carry all 10 pairs (see "FX data architecture" in
# README.md for the exact split and the economics behind it):
# Twelve Data (free tier, 800 req/day, 8/min): https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=
# Finnhub (free tier, ~60 req/min): https://finnhub.io/
FINNHUB_API_KEY=

# Shared secret the tracking cron job must present. Generate any random
# string (e.g. `openssl rand -hex 32`) — required, the endpoint refuses to
# run without it.
CRON_SECRET=

# ── Premium billing (Paystack) ──
# https://dashboard.paystack.com/#/settings/developer — use TEST keys
# until you're ready to go live. NEVER prefix this with NEXT_PUBLIC_ —
# it must never reach the browser.
PAYSTACK_SECRET_KEY=

# Paystack Dashboard → Products → Plans, if you want recurring billing.
# Leave blank to charge a one-off amount instead (see AMOUNT_KOBO below).
PAYSTACK_PREMIUM_PLAN_CODE=

# Only used when PAYSTACK_PREMIUM_PLAN_CODE is blank. Amount in kobo
# (₦1 = 100 kobo) — default below is ₦5,000.
PAYSTACK_PREMIUM_AMOUNT_KOBO=500000

# Length of one billing period in days (monthly plan = 30). Access runs
# this long after each successful payment, plus a 5-day grace window, so
# a lapsed subscription can never grant access indefinitely.
PAYSTACK_PREMIUM_PERIOD_DAYS=30

# Your deployed site's base URL, used to build the Paystack checkout
# callback URL (https://your-domain, no trailing slash). On Netlify this
# can be left blank — process.env.URL is used as a fallback — but set it
# explicitly if you're on a custom domain that differs from the Netlify
# default one.
APP_URL=
